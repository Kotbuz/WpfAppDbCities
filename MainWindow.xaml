<Window x:Class="WpfAppDbCities.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppDbCities"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closing="Window_Closing" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="447*"/>
            <ColumnDefinition Width="353*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="tb_query" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="SELECT * FROM cities" VerticalAlignment="Top" Width="332" Height="72"/>
        <Button x:Name="btn_send" Content="Send" HorizontalAlignment="Left" Margin="10,87,0,0" VerticalAlignment="Top" Width="80" Height="20" Click="Button_Click"/>
        <DataGrid x:Name="dg_query" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="2" Margin="0,112,0,0"/>
        <Button x:Name="btn_min" Content="Minimum" HorizontalAlignment="Left" Margin="95,87,0,0" VerticalAlignment="Top" Height="20" Click="btn_min_Click"/>
        <Button x:Name="btn_max" Content="Maximum" HorizontalAlignment="Left" Margin="155,87,0,0" VerticalAlignment="Top" Height="20" Click="btn_max_Click"/>
        <Button x:Name="btn_count" Content="Count" HorizontalAlignment="Left" Margin="217,87,0,0" VerticalAlignment="Top" Height="20" Click="btn_count_Click"/>
        <Button x:Name="btn_sum" Content="Sum" HorizontalAlignment="Left" Margin="258,87,0,0" VerticalAlignment="Top" Height="20" Click="btn_sum_Click"/>
        <Button x:Name="btn_avg" Content="Avg" HorizontalAlignment="Left" Margin="290,87,0,0" VerticalAlignment="Top" Height="20" Click="btn_avg_Click"/>
        <Button x:Name="btn_all" Content="ALL" HorizontalAlignment="Left" Margin="319,87,0,0" VerticalAlignment="Top" Height="20" Click="btn_all_Click"/>
        <TextBox x:Name="tb_name" HorizontalAlignment="Right" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="332" Height="25" Grid.Column="1"/>
        <TextBox x:Name="tb_population" HorizontalAlignment="Right" Margin="0,57,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="332" Height="25" Grid.Column="1"/>
        <Button x:Name="btn_add" Content="Add City" HorizontalAlignment="Left" Margin="10,87,0,0" VerticalAlignment="Top" Width="80" Height="20"  Grid.Column="1" Click="btn_add_Click"/>
        <Label Content="Название" HorizontalAlignment="Right" Margin="0,10,337,0" VerticalAlignment="Top" Width="69" Grid.ColumnSpan="2" Height="25"/>
        <Label Content="Население" HorizontalAlignment="Right" Margin="0,57,338,0" VerticalAlignment="Top" Width="68" Grid.ColumnSpan="2" Height="25"/>

    </Grid>
</Window>
